  "info": {
    "title": "DukaanHQ API",
    "description": "SMS authentication and account bootstrap. Twilio delivers OTP through Supabase Auth. Use Bearer tokens; role intent grants no membership. Money: exact decimal strings; timestamps: UTC ISO 8601.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LiveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "rules"
        ]
      },
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "SERVICE_UNAVAILABLE"
          },
          "message": {
            "type": "string",
            "example": "Service temporarily unavailable."
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "required": [
          "error"
        ]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+919876543210",
            "description": "Valid international E.164 phone, including country calling code."
          },
          "captcha_token": {
            "type": "string",
            "description": "Supabase-configured CAPTCHA response token."
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpAcceptedResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "example": true
          },
          "retry_after_seconds": {
            "type": "number",
            "example": 60
          },
          "otp_length": {
            "type": "number",
            "example": 6
          },
          "expires_in_seconds": {
            "type": "number",
            "example": 300
          }
        },
        "required": [
          "accepted",
          "retry_after_seconds",
          "otp_length",
          "expires_in_seconds"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+919876543210",
            "description": "Valid international E.164 phone, including country calling code."
          },
          "token": {
            "type": "string",
            "example": "123456",
            "description": "Digits only; length must match the configured provider."
          }
        },
        "required": [
          "phone",
          "token"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "full_name": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string"
          },
          "onboarding_intent": {
            "type": "string",
            "enum": [
              "owner",
              "staff"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "phone",
          "role",
          "onboarding_intent"
        ]
      },
      "MembershipResponse": {
        "type": "object",
        "properties": {
          "shop_id": {
            "type": "string",
            "format": "uuid"
          },
          "shop_slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "staff"
            ]
          },
          "status": {
            "type": "string"
          },
          "shop_status": {
            "type": "string"
          },
          "onboarding_completed": {
            "type": "boolean"
          }
        },
        "required": [
          "shop_id",
          "shop_slug",
          "role",
          "status",
          "shop_status",
          "onboarding_completed"
        ]
      },
      "AccessResponse": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "boolean"
          },
          "can_manage_staff": {
            "type": "boolean"
