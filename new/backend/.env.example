NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
OPENAPI_ENABLED=true
# No database or Redis is needed for liveness/docs. Readiness stays 503 until configured.
# Use a dedicated non-superuser, non-BYPASSRLS login with membership in authenticated.
# Never use the Supabase service-role API key as a database credential.
DATABASE_URL=
DATABASE_SSL=true
# Optional Supabase CA trust; Bun loads this before launching Node.
# NODE_EXTRA_CA_CERTS=certs/supabase-ca.crt
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=3000
DATABASE_LOCK_TIMEOUT_MS=1000
REDIS_URL=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
# Set only behind a known proxy/network, never blindly trust forwarded client IPs.
TRUST_PROXY_HOPS=0
SLOW_REQUEST_MS=500

# Phase 2. Configure Twilio SMS inside Supabase Auth, not on Android.
# Enable only after applying web/db/046_mobile_phone_auth.sql to staging.
AUTH_ENABLED=false
SUPABASE_URL=
# Project publishable key (or legacy anon key); NEVER service-role/secret key.
SUPABASE_PUBLISHABLE_KEY=
AUTH_TIMEOUT_MS=4000
# Match the Supabase SMS configuration. Provider enforces actual code expiry.
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
# Generate a random secret of at least 32 characters, shared by all API replicas.
# Required in production; protects phone/IP values in Redis keys.
OTP_RATE_LIMIT_SECRET=
