{
  "name": "@dukaanhq/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "benchmark": "bun run build && node dist/scripts/benchmark.js",
    "openapi": "bun run build && node dist/scripts/openapi.js",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.3.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-fastify": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.11",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "node": "24.22.3",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
